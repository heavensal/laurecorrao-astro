# English routes. false: French only, no /en/ URLs. true: generate /en/ and show the language switcher.
# hreflang still follows siteConfig.publishedLocales (Laure Corrao: fr).
ENABLE_MULTILANG=false

# Forge blocks. Articles come from Forge. FAQ and reviews stay in this repository.
# "true" fetches that resource at build time. A failed fetch does not generate /blog.
FORGE_FAQ_ENABLED=false
FORGE_REVIEWS_ENABLED=false
FORGE_ARTICLES_ENABLED=true
FORGE_URL=https://forge.1344.fr/api/v1
# Website token from Forge (laurecorrao.fr). Required for /blog to be generated.
FORGE_API_TOKEN=

# Contact form: Forge send_form (exposed to the browser — use the website token, not a global secret).
PUBLIC_CONTACT_FORM_URL=https://forge.1344.fr/api/v1/send_form
PUBLIC_CONTACT_FORM_TOKEN=
