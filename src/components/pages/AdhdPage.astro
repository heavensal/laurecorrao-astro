---
import BookingDetails from '../BookingDetails.astro';
import overview from '../../assets/images/adhd/attention-and-organization.webp';
import child from '../../assets/images/adhd/child-building.webp';
import teen from '../../assets/images/adhd/teen-studying.webp';
import adult from '../../assets/images/adhd/adult-planning.webp';
import { getFixedT, type Locale } from '../../i18n/i18n';
import { contentPath, pageHref } from '../../lib/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const images = { overview, child, teen, adult };
const spread =
	'mx-auto grid max-w-6xl items-center gap-4 border-t border-line px-6 py-8 first:border-t-0 md:grid-cols-9 md:gap-10 md:px-10 md:py-12 lg:px-16 lg:py-16';
const button =
	'mt-6 inline-flex min-h-12 items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white no-underline transition-colors duration-200 hover:border-rose-deep hover:bg-rose-deep';
---

<article>
	{
		Object.entries(images).map(([key, src], index) => {
			const imageFirst = index % 2 === 1;
			return (
				<section class={spread}>
					<div class={imageFirst ? 'md:order-2 md:col-span-5' : 'md:col-span-5'}>
						{key === 'overview' ? (
							<h1 class="my-6 font-serif text-4xl leading-tight md:text-5xl lg:text-6xl">{t('Adhd.overview.title')}</h1>
						) : (
							<h2 class="mt-0 mb-5 font-serif text-3xl leading-tight">{t(`Adhd.${key}.title`)}</h2>
						)}
						<p class="mb-5">{t(`Adhd.${key}.intro`)}</p>
						<p class="mb-5">{t(`Adhd.${key}.body`)}</p>
						{key !== 'overview' && (
							<p class="mb-5 border-l-4 border-rose-laure pl-4">
								<strong>{t(`Adhd.${key}.goal`)}</strong>
							</p>
						)}
					</div>
					<img
						class:list={[imageFirst ? 'md:order-1 md:col-span-4' : 'md:col-span-4', 'h-auto w-full rounded-2xl']}
						src={src.src}
						width={src.width}
						height={src.height}
						alt={t(`Adhd.${key}.alt`)}
						decoding="async"
						loading={key === 'overview' ? 'eager' : 'lazy'}
					/>
				</section>
			);
		})
	}
	<section class="bg-sand px-6 py-14 text-center">
		<h2 class="mb-5 font-serif text-3xl leading-tight">{t('Adhd.first.title')}</h2>
		<p class="mx-auto mb-5 max-w-prose">{t('Adhd.first.body')}</p>
		<p class="mx-auto mb-5 max-w-prose">{t('Adhd.first.scope')}</p>
		<BookingDetails locale={locale} />
		<a class={button} href={pageHref(`${contentPath(locale, 'booking')}/#agenda`)}>
			{t('Nav.bookingCta')}
		</a>
		<p class="mx-auto mt-8 max-w-prose text-sm text-muted">{t('Adhd.sources')}</p>
	</section>
</article>
