---
import PageBreadcrumb from '../PageBreadcrumb.astro';
import BookingDetails from '../BookingDetails.astro';
import overview from '../../assets/images/adhd/attention-and-organization.webp';
import child from '../../assets/images/adhd/child-building.webp';
import teen from '../../assets/images/adhd/teen-studying.webp';
import adult from '../../assets/images/adhd/adult-planning.webp';
import { getFixedT, type Locale } from '../../i18n/i18n';
import { contentPath, pageHref } from '../../lib/paths';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getFixedT(locale);
const titleId = 'adhd-title';
const bookingHeadingId = 'adhd-booking-heading';
const blocks = [
	['overview', overview],
	['child', child],
	['teen', teen],
	['adult', adult],
] as const;
const sectionBase =
	'mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 border-line px-6 lg:grid-cols-2';
const photo = 'block h-auto w-full rounded-2xl shadow-sm ring-1 ring-line';

function sectionLabelId(key: (typeof blocks)[number][0]): string {
	return key === 'overview' ? titleId : `adhd-${key}-heading`;
}
---

<article aria-labelledby={titleId}>
	<PageBreadcrumb locale={locale} current={String(t('Adhd.overview.title'))} />
	{
		blocks.map(([key, src], index) => (
			<section
				class:list={[sectionBase, index === 0 ? 'pb-16' : 'py-16']}
				aria-labelledby={sectionLabelId(key)}
			>
				<div class={index % 2 === 1 ? 'lg:col-start-2 lg:row-start-1' : undefined}>
					{key === 'overview' ? (
						<>
							<h1
								id={titleId}
								class="mb-6 font-serif text-4xl leading-tight tracking-tight text-ink md:text-5xl lg:text-6xl"
							>
								{t('Adhd.overview.title')}
							</h1>
						</>
					) : (
						<h2 id={sectionLabelId(key)} class="mb-5 font-serif text-3xl leading-tight text-ink">
							{t(`Adhd.${key}.title`)}
						</h2>
					)}
					<p class="mb-5">{t(`Adhd.${key}.intro`)}</p>
					<p class="mb-5">{t(`Adhd.${key}.body`)}</p>
					{key !== 'overview' && (
						<p class="border-l-4 border-rose-laure pl-4">
							<strong>{t(`Adhd.${key}.goal`)}</strong>
						</p>
					)}
				</div>
				<img
					class:list={[photo, index % 2 === 1 && 'lg:col-start-1 lg:row-start-1']}
					src={src.src}
					width={src.width}
					height={src.height}
					alt={t(`Adhd.${key}.alt`)}
					decoding="async"
					loading={key === 'overview' ? 'eager' : 'lazy'}
					fetchpriority={key === 'overview' ? 'high' : undefined}
				/>
			</section>
		))
	}
	<section
		class="bg-rose-laure px-6 py-14 text-center text-white md:px-16"
		aria-labelledby={bookingHeadingId}
	>
		<h2 id={bookingHeadingId} class="font-serif text-3xl leading-tight md:text-4xl">
			{t('Adhd.first.title')}
		</h2>
		<div class="mx-auto max-w-prose text-start text-sand">
			<p class="my-4">{t('Adhd.first.body')}</p>
			<p class="my-4">{t('Adhd.first.scope')}</p>
		</div>
		<BookingDetails locale={locale} variant="onRose" />
		<button
			class="mt-6 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-white bg-white px-6 py-3 text-sm text-rose-deep transition-colors duration-200 hover:bg-sand"
			type="button"
			data-booking-open
		>
			{t('Nav.bookingCta')}
		</button>
		<p class="mx-auto mt-8 max-w-prose text-sm text-sand" role="note">
			{t('Adhd.sources')}
		</p>
	</section>
</article>