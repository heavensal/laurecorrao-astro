---
import BookingCTA from '../BookingCTA.astro';
import CalEmbed from '../CalEmbed.astro';
import { getFixedT, type Locale } from '../../i18n/i18n';

interface Props {
	locale: Locale;
}

interface Section {
	title: string;
	lines?: string[];
	paragraphs?: string[];
	items?: string[];
	after?: string[];
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const sectionsValue = t('Booking.sections', { returnObjects: true });
const sections: Section[] = Array.isArray(sectionsValue) ? sectionsValue : [];
---

<div class="mx-auto max-w-6xl px-6 pt-16 pb-6 md:px-10">
	<p class="mb-4 text-xs tracking-widest text-rose-laure uppercase">{t('Pages.eyebrow')}</p>
	<h1 class="font-serif text-4xl leading-tight tracking-tight md:text-5xl">{t('Booking.h1')}</h1>
</div>
<article class="mx-auto max-w-3xl px-6 pb-16 leading-relaxed">
	<p class="mb-6 font-serif text-xl leading-snug">{t('Booking.lede')}</p>
	<p class="mb-6">{t('Booking.intro')}</p>
	{
		sections.map((section) => (
			<>
				<h2 class="mt-10 font-serif text-3xl leading-tight">{section.title}</h2>
				{section.lines && (
					<p class="mt-4 mb-6">
						{section.lines[0]}
						<br />
						{section.lines[1]}
					</p>
				)}
				{section.paragraphs?.map((paragraph) => <p class="mb-6">{paragraph}</p>)}
				{section.items && (
					<ul class="mb-6 list-disc pl-6">
						{section.items.map((item) => (
							<li class="py-1">{item}</li>
						))}
					</ul>
				)}
				{section.after?.map((paragraph) => <p class="mb-6">{paragraph}</p>)}
			</>
		))
	}
	<p class="mb-6">{t('Booking.closing')}</p>
</article>
<section class="scroll-mt-8 px-6 py-16 md:px-10" id="agenda">
	<h2 class="font-serif text-3xl leading-tight">{t('Booking.agendaTitle')}</h2>
	<p class="mt-6 border-l-4 border-rose-laure bg-sand px-5 py-4">{t('Booking.agendaNotice')}</p>
	<CalEmbed locale={locale} />
</section>
<BookingCTA locale={locale} />
