---
import PageBreadcrumb from '../PageBreadcrumb.astro';
import BookingDetails from '../BookingDetails.astro';
import family from '../../assets/images/parenting/family-conversation.webp';
import { getFixedT, type Locale } from '../../i18n/i18n';
import { contentPath, pageHref } from '../../lib/paths';
import { siteConfig } from '../../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const titleId = 'parenting-title';
const approachHeadingId = 'parenting-approach-heading';
const sessionsHeadingId = 'parenting-sessions-heading';
const placeHeadingId = 'parenting-place-heading';
const bookingHeadingId = 'parenting-booking-heading';
const closingAria = String(t('Parenting.closingAria'));

const focusValue = t('Parenting.focusItems', { returnObjects: true });
const focusItems = Array.isArray(focusValue) ? focusValue.map(String) : [];

const heroSection =
	'mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 border-line px-6 pb-16 md:px-10 lg:grid-cols-2';
const photo = 'block h-auto w-full rounded-2xl shadow-sm ring-1 ring-line';
---

<article aria-labelledby={titleId}>
	<PageBreadcrumb locale={locale} current={String(t('Parenting.h1'))} />

	<section class={heroSection} aria-labelledby={titleId}>
		<div>
			<h1
				id={titleId}
				class="mb-6 font-serif text-4xl leading-tight tracking-tight text-ink md:text-5xl lg:text-6xl"
			>
				{t('Parenting.h1')}
			</h1>
			<p class="mb-5 text-lg leading-relaxed">{t('Parenting.intro')}</p>
		</div>
		<img
			class={photo}
			src={family.src}
			width={family.width}
			height={family.height}
			alt={t('Parenting.alt')}
			decoding="async"
			loading="eager"
			fetchpriority="high"
		/>
	</section>

	<section class="bg-sand px-6 py-14 md:px-10" aria-labelledby={approachHeadingId}>
		<div class="mx-auto max-w-3xl">
			<h2 id={approachHeadingId} class="font-serif text-2xl leading-tight text-ink md:text-3xl">
				{t('Parenting.approachHeading')}
			</h2>
			<p class="mt-6 leading-relaxed">
				<strong>{t('Parenting.support')}</strong>
				{' '}
				{t('Parenting.space')}
			</p>
			<p class="mt-6 font-medium text-ink">{t('Parenting.listIntro')}</p>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
				{
					focusItems.map((item) => (
						<li class="rounded-xl border border-line/60 bg-paper px-4 py-3 text-sm leading-relaxed text-ink shadow-sm">
							{item}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section
		class="mx-auto max-w-3xl px-6 py-14 leading-relaxed md:px-10"
		aria-labelledby={sessionsHeadingId}
	>
		<h2 id={sessionsHeadingId} class="font-serif text-2xl leading-tight text-ink md:text-3xl">
			{t('Parenting.sessionsHeading')}
		</h2>
		<p class="mt-6">{t('Parenting.sessions')}</p>
		<p class="mt-8 border-l-4 border-rose-laure pl-4">
			<strong>{t('Parenting.goal')}</strong>
		</p>
	</section>

	<section class="mx-auto max-w-3xl px-6 pb-6 md:px-10" aria-labelledby={placeHeadingId}>
		<h2 id={placeHeadingId} class="font-serif text-2xl leading-tight text-ink md:text-3xl">
			{t('Parenting.placeHeading')}
		</h2>
		<p class="mt-4 leading-relaxed">{t('Parenting.placeBody')}</p>
		<p class="mt-3 text-muted">{t('HomePage.practiceAddress')}</p>
		<p class="mt-4">
			<a
				class="text-rose-laure underline underline-offset-4"
				href={siteConfig.mapsUrl}
				rel="noopener noreferrer"
				target="_blank"
			>
				{t('HomePage.practiceMapsLabel')}
				<span class="absolute -m-px h-px w-px overflow-hidden border-0 p-0 whitespace-nowrap">
					{t('Parenting.mapsOpensNewTab')}
				</span>
			</a>
		</p>
	</section>

	<section class="border-y border-line bg-cream px-6 py-14 md:px-10" aria-label={closingAria}>
		<blockquote class="relative mx-auto max-w-2xl px-4 text-center">
			<span class="absolute top-0 left-1/2 -translate-x-1/2 font-serif text-5xl text-blush" aria-hidden="true">
				“
			</span>
			<p class="pt-8 font-serif text-xl leading-snug text-ink md:text-2xl">{t('Parenting.reassurance')}</p>
		</blockquote>
	</section>

	<section
		class="bg-rose-laure px-6 py-14 text-center text-white md:px-16"
		aria-labelledby={bookingHeadingId}
	>
		<h2 id={bookingHeadingId} class="font-serif text-3xl leading-tight md:text-4xl">
			{t('Parenting.first.title')}
		</h2>
		<div class="mx-auto max-w-prose text-start text-sand">
			<p class="my-4">{t('Parenting.first.body')}</p>
			<p class="my-4">{t('Parenting.first.scope')}</p>
		</div>
		<BookingDetails locale={locale} variant="onRose" />
		<button
			class="mt-6 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-white bg-white px-6 py-3 text-sm text-rose-deep transition-colors duration-200 hover:bg-sand"
			type="button"
			data-booking-open
		>
			{t('Nav.bookingCta')}
		</button>
	</section>
</article>