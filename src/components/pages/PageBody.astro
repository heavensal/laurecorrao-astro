---
import LegalNoticeArticle from '../legal/LegalNoticeArticle.astro';
import PrivacyArticle from '../legal/PrivacyArticle.astro';
import TermsArticle from '../legal/TermsArticle.astro';
import type { Locale } from '../../i18n/i18n';
import type { ContentKind } from '../../lib/pages';
import AdhdPage from './AdhdPage.astro';
import ParentingPage from './ParentingPage.astro';
import FeesPage from './FeesPage.astro';
import IndividualPage from './IndividualPage.astro';
import CouplePage from './CouplePage.astro';
import ApproachPage from './ApproachPage.astro';

interface Props {
	locale: Locale;
	kind: ContentKind;
}

const { locale, kind } = Astro.props;
---

{kind === 'adhd' && <AdhdPage locale={locale} />}
{kind === 'parenting' && <ParentingPage locale={locale} />}
{kind === 'individual' && <IndividualPage locale={locale} />}
{kind === 'couple' && <CouplePage locale={locale} />}
{kind === 'approach' && <ApproachPage locale={locale} />}
{kind === 'booking' && <FeesPage locale={locale} />}
{kind === 'legal-notice' && <LegalNoticeArticle locale={locale} />}
{kind === 'privacy-policy' && <PrivacyArticle locale={locale} />}
{kind === 'terms-of-service' && <TermsArticle locale={locale} />}
