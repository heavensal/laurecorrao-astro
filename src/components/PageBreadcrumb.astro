---
import { getFixedT, type Locale } from '../i18n/i18n';
import { homePathForLocale, pageHref } from '../lib/paths';

interface CrumbLink {
	label: string;
	href: string;
}

interface Props {
	locale: Locale;
	current: string;
	/** Optional middle crumb, e.g. blog index before an article title. */
	parent?: CrumbLink;
	class?: string;
}

const { locale, current, parent, class: className } = Astro.props;
const t = getFixedT(locale);
const homeHref = pageHref(homePathForLocale(locale) || '/');
const navClass = className ?? 'mx-auto max-w-6xl px-6 pt-10 pb-6 md:px-10';
const linkClass = 'text-rose-laure underline underline-offset-4';
---

<nav class={navClass} aria-label={String(t('Pages.breadcrumbAria'))}>
	<ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
		<li>
			<a class={linkClass} href={homeHref}>{t('Nav.home')}</a>
		</li>
		{
			parent && (
				<>
					<li aria-hidden="true" class="text-muted">/</li>
					<li>
						<a class={linkClass} href={parent.href}>{parent.label}</a>
					</li>
				</>
			)
		}
		<li aria-hidden="true" class="text-muted">/</li>
		<li>
			<span class="text-ink" aria-current="page">{current}</span>
		</li>
	</ol>
</nav>