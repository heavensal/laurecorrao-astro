---
import { Image } from 'astro:assets';
import journey from '../assets/images/individual/at-your-own-pace.webp';
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
	/** Associates the illustration with a nearby heading for assistive tech. */
	describedBy?: string;
}

const { locale, describedBy } = Astro.props;
const t = getFixedT(locale);
---
<figure class="my-6 mb-8" aria-describedby={describedBy}>
	<Image
		class="block h-auto w-full rounded-2xl"
		src={journey}
		widths={[480, 768, 1200]}
		sizes="(min-width: 1024px) 42rem, 100vw"
		alt={t('Individual.journeyAlt')}
	/>
	<figcaption class="mt-2 text-end text-sm">
		<a class="text-rose-laure underline underline-offset-4" href={journey.src}>
			{t('Individual.viewJourney')}
		</a>
	</figcaption>
</figure>
