---
import journey from '../assets/images/individual/at-your-own-pace.webp';
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
}

const t = getFixedT(Astro.props.locale);
---

<figure class="mt-6 mb-8">
	<img
		class="block h-auto w-full rounded-2xl"
		src={journey.src}
		width={journey.width}
		height={journey.height}
		loading="lazy"
		decoding="async"
		alt={t('Individual.journeyAlt')}
	/>
	<figcaption class="mt-2 text-end text-sm">
		<a class="text-rose-laure underline underline-offset-4" href={journey.src}>{t('Individual.viewJourney')}</a>
	</figcaption>
</figure>
