---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { contentPath, homePathForLocale, legalPath, pageHref } from '../../lib/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale) || '/');
const sections = t('Terms.sections', { returnObjects: true }) as {
	title: string;
	paragraphs: string[];
	link?: 'booking' | 'privacy';
}[];
const links = {
	booking: pageHref(contentPath(locale, 'booking') + '/#agenda'),
	privacy: pageHref(legalPath(locale, 'privacyPolicy') + '/'),
};
---

<article>
	<div class="mx-auto max-w-6xl px-6 pt-16 pb-6">
		<p class="my-4"><a href={homeUrl}>{t('Terms.back')}</a></p>
		<h1 class="font-serif text-4xl leading-tight md:text-5xl">{t('Terms.h1')}</h1>
		<p class="my-4">{t('Terms.subtitle')}</p>
		<p class="my-4">{t('Terms.updated')}</p>
	</div>
	<div class="prose mx-auto max-w-3xl px-6 pb-16 leading-relaxed">
		{sections.map(({ title, paragraphs, link }) => (
			<section>
				<h2 class="mt-10 font-serif text-3xl leading-tight">{title}</h2>
				{paragraphs.map((paragraph) => <p class="my-4 whitespace-pre-line">{paragraph}</p>)}
				{link && (
					<p class="my-4">
						<a class="text-rose-laure underline underline-offset-4" href={links[link]}>{t(`Terms.${link}`)}</a>
					</p>
				)}
			</section>
		))}
	</div>
</article>
