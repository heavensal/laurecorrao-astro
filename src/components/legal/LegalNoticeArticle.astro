---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { homePathForLocale, pageHref } from '../../lib/paths';
import { siteConfig } from '../../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale) || '/');
const email = siteConfig.contact.email;
const publisher = t('LegalNotice.s1p1') + (email ? t('LegalNotice.s1p1After', { email }) : '');
---

<article>
	<div class="mx-auto max-w-6xl px-6 pt-16 pb-6">
		<p class="mb-6"><a class="underline underline-offset-4" href={homeUrl}>{t('LegalNotice.back')}</a></p>
		<h1 class="font-serif text-4xl leading-tight tracking-tight md:text-5xl">{t('LegalNotice.h1')}</h1>
		<p class="mt-4 mb-6">{t('LegalNotice.updated')}</p>
	</div>
	<div class="mx-auto max-w-3xl px-6 pb-16 leading-relaxed">
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s1h')}</h2>
			<p class="mt-4 mb-6" set:html={publisher} />
		</section>
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s2h')}</h2>
			<p class="mt-4 mb-6">{t('LegalNotice.s2p1')}</p>
		</section>
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s3h')}</h2>
			<p class="mt-4 mb-6" set:html={t('LegalNotice.s3p1')} />
		</section>
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s4h')}</h2>
			<p class="mt-4 mb-6">{t('LegalNotice.s4p1')}</p>
		</section>
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s5h')}</h2>
			<p class="mt-4 mb-6">{t('LegalNotice.s5p1')}</p>
		</section>
		<section>
			<h2 class="mt-10 font-serif text-3xl leading-tight">{t('LegalNotice.s6h')}</h2>
			<p class="mt-4 mb-6">{t('LegalNotice.s6p1')}</p>
		</section>
	</div>
</article>
