---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { homePathForLocale, pageHref } from '../../lib/paths';
import { siteConfig } from '../../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale) || '/');
const email = siteConfig.contact.email;
const controller = t('Privacy.s1p1') + (email ? t('Privacy.s1p1After', { email }) : '');
---

<article>
	<div class="page-head">
		<p><a href={homeUrl}>{t('Privacy.back')}</a></p>
		<h1>{t('Privacy.h1')}</h1>
		<p>{t('Privacy.updated')}</p>
	</div>
	<div class="prose">
		<section>
			<h2>{t('Privacy.s1h')}</h2>
			<p set:html={controller} />
			<p>{t('Privacy.s1p2')}</p>
		</section>
		<section>
			<h2>{t('Privacy.s2h')}</h2>
			<p>{t('Privacy.s2p1')}</p>
			<p>{t('Privacy.s2p2')}</p>
		</section>
		<section>
			<h2>{t('Privacy.s3h')}</h2>
			<p>{t('Privacy.s3p1')}</p>
			<p>{t('Privacy.s3p2')}</p>
		</section>
		<section>
			<h2>{t('Privacy.s4h')}</h2>
			<p>{t('Privacy.s4p1')}</p>
		</section>
		<section>
			<h2>{t('Privacy.s5h')}</h2>
			<p>{t('Privacy.s5p1')}</p>
			<p set:html={t('Privacy.s5p2')} />
		</section>
		<section>
			<h2>{t('Privacy.s6h')}</h2>
			<p>{t('Privacy.s6p1')}</p>
			{email && <p set:html={t('Privacy.s6p2', { email })} />}
			<p set:html={t('Privacy.s6p3')} />
		</section>
		<section>
			<h2>{t('Privacy.s7h')}</h2>
			<p>{t('Privacy.s7p1')}</p>
			<p>{t('Privacy.s7p2')}</p>
		</section>
		<section>
			<h2>{t('Privacy.s8h')}</h2>
			<p>{t('Privacy.s8p1')}</p>
		</section>
	</div>
</article>
