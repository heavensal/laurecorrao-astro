---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { homePathForLocale, pageHref } from '../../lib/paths';
import { siteConfig } from '../../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale) || '/');
const sections = t('Privacy.sections', { returnObjects: true }) as {
	title: string;
	paragraphs: string[];
	contact?: boolean;
	links?: { label: string; href: string }[];
}[];
const { legal, contact } = siteConfig;
---

<article>
	<div class="mx-auto max-w-6xl px-6 pt-16 pb-6">
		<p class="my-4"><a href={homeUrl}>{t('Privacy.back')}</a></p>
		<h1 class="font-serif text-4xl leading-tight md:text-5xl">{t('Privacy.h1')}</h1>
		<p class="my-4">{t('Privacy.updated')}</p>
	</div>
	<div class="prose mx-auto max-w-3xl px-6 pb-16 leading-relaxed">
		{sections.map((section) => (
			<section>
				<h2 class="mt-10 font-serif text-3xl leading-tight">{section.title}</h2>
				{section.paragraphs.map((paragraph) => <p class="my-4">{paragraph}</p>)}
				{section.contact && (
					<address>
						{legal.name}<br />{legal.building}<br />{legal.street}<br />
						{legal.postalCode} {legal.city}, France<br />
						<a href={`tel:${contact.phoneE164}`}>{contact.phone}</a>
						{contact.email && <><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></>}
					</address>
				)}
				{section.links?.map((link) => <p class="my-4"><a href={link.href}>{link.label}</a></p>)}
			</section>
		))}
	</div>
</article>
