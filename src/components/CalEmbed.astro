---
import { getFixedT, type Locale } from '../i18n/i18n';
import { siteConfig } from '../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const configured = import.meta.env.PUBLIC_CAL_LINK?.trim() ?? '';
const provisional = 'adam-1344-vm70qf/30min';
const calLink = configured === provisional ? '' : configured;
const button =
	'mt-6 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white transition-colors duration-200 hover:border-rose-deep hover:bg-rose-deep';
---

{
	calLink ? (
		<>
			<p id="cal-status" role="status" data-error={t('Calendar.loadError')} data-frame-title={t('Calendar.frameTitle')}>
				{t('Calendar.loading')}
			</p>
			<div id="my-cal-inline" class="min-h-175 w-full overflow-auto" data-cal-link={calLink} aria-label={t('Calendar.aria')} />
			<noscript>
				<p>{t('Calendar.noscript')}</p>
			</noscript>
			<script is:inline>
				(function (C, A, L) {
					let p = function (a, ar) {
						a.q.push(ar);
					};
					let d = C.document;
					C.Cal =
						C.Cal ||
						function () {
							let cal = C.Cal;
							let ar = arguments;
							if (!cal.loaded) {
								cal.ns = {};
								cal.q = cal.q || [];
								const script = d.createElement('script');
								script.src = A;
								script.onerror = () => {
									const status = d.getElementById('cal-status');
									if (status) status.textContent = status.dataset.error || '';
								};
								d.head.appendChild(script);
								cal.loaded = true;
							}
							if (ar[0] === L) {
								const api = function () {
									p(api, arguments);
								};
								const namespace = ar[1];
								api.q = api.q || [];
								if (typeof namespace === 'string') {
									cal.ns[namespace] = cal.ns[namespace] || api;
									p(cal.ns[namespace], ar);
									p(cal, ['initNamespace', namespace]);
								} else {
									p(cal, ar);
								}
								return;
							}
							p(cal, ar);
						};
				})(window, 'https://app.cal.com/embed/embed.js', 'init');

				const frame = document.getElementById('my-cal-inline');
				const calLink = frame?.dataset.calLink || '';
				Cal('init', 'booking', { origin: 'https://cal.com' });
				Cal.ns.booking('inline', {
					elementOrSelector: '#my-cal-inline',
					calLink,
					config: { layout: 'month_view', theme: 'light' },
				});
				Cal.ns.booking('on', {
					action: '__iframeReady',
					callback: () => {
						const status = document.getElementById('cal-status');
						if (status) status.hidden = true;
						const embedded = document.querySelector('#my-cal-inline iframe');
						if (embedded) embedded.title = status?.dataset.frameTitle || '';
					},
				});
			</script>
		</>
	) : (
		<div class="mx-auto mt-6 max-w-prose text-start">
			<p>{t('Calendar.unavailable')}</p>
			<p class="mt-4">
				<a class="text-rose-laure underline underline-offset-4" href={`tel:${siteConfig.contact.phoneE164}`}>
					{siteConfig.contact.phone}
				</a>
			</p>
			<button class={button} type="button" data-contact-open>
				{t('Footer.contact')}
			</button>
		</div>
	)
}
