---
import { getFixedT, type Locale } from '../i18n/i18n';
import { calBrandDark, calBrandLight, calLink } from '../lib/cal';

interface Props {
	locale: Locale;
	elementId?: string;
	statusId?: string;
	namespace?: string;
	containerClass?: string;
	closeDialogOnBooking?: boolean;
	dialogId?: string;
}

const {
	locale,
	elementId = 'my-cal-inline-15min',
	statusId = 'cal-status',
	namespace = '15min',
	containerClass = 'min-h-screen w-full overflow-auto',
	closeDialogOnBooking = false,
	dialogId = '',
} = Astro.props;
const t = getFixedT(locale);
---

<p id={statusId} role="status" data-error={t('Calendar.loadError')} data-frame-title={t('Calendar.frameTitle')}>
	{t('Calendar.loading')}
</p>
<div id={elementId} class={containerClass} aria-label={t('Calendar.aria')}></div>
<noscript><p>{t('Calendar.noscript')}</p></noscript>

<script
	is:inline
	type="module"
	define:vars={{ calLink, calBrandLight, calBrandDark, elementId, statusId, namespace, closeDialogOnBooking, dialogId }}
>
	const calHost = document.getElementById(elementId);

	const mountCal = () => {
		if (!calHost || calHost.dataset.calMounted === 'true') return;
		calHost.dataset.calMounted = 'true';

		(function (C, A, L) {
			let p = function (a, ar) {
				a.q.push(ar);
			};
			let d = C.document;
			C.Cal =
				C.Cal ||
				function () {
					let cal = C.Cal;
					let ar = arguments;
					if (!cal.loaded) {
						cal.ns = {};
						cal.q = cal.q || [];
						const script = d.createElement('script');
						script.src = A;
						script.onerror = () => {
							document.querySelectorAll('[id^="cal-"][role="status"], [data-cal-status]').forEach((status) => {
								if (status instanceof HTMLElement && status.dataset.error) {
									status.textContent = status.dataset.error;
								}
							});
						};
						d.head.appendChild(script);
						cal.loaded = true;
					}
					if (ar[0] === L) {
						const api = function () {
							p(api, arguments);
						};
						const namespace = ar[1];
						api.q = api.q || [];
						if (typeof namespace === 'string') {
							cal.ns[namespace] = cal.ns[namespace] || api;
							p(cal.ns[namespace], ar);
							p(cal, ['initNamespace', namespace]);
						} else {
							p(cal, ar);
						}
						return;
					}
					p(cal, ar);
				};
		})(window, 'https://app.cal.com/embed/embed.js', 'init');

		Cal('init', namespace, { origin: 'https://app.cal.com' });
		Cal.config = Cal.config || {};
		Cal.config.forwardQueryParams = true;

		Cal.ns[namespace]('inline', {
			elementOrSelector: `#${elementId}`,
			calLink,
			config: {
				layout: 'month_view',
				useSlotsViewOnSmallScreen: true,
				theme: 'light',
			},
		});

		Cal.ns[namespace]('ui', {
			theme: 'light',
			cssVarsPerTheme: {
				light: { 'cal-brand': calBrandLight },
				dark: { 'cal-brand': calBrandDark },
			},
			hideEventTypeDetails: true,
			layout: 'month_view',
		});

		const hideStatus = () => {
			const status = document.getElementById(statusId);
			if (status) status.hidden = true;
			const frame = document.querySelector(`#${elementId} iframe`);
			if (frame) frame.title = status?.dataset.frameTitle || '';
		};

		Cal.ns[namespace]('on', {
			action: '__iframeReady',
			callback: hideStatus,
		});

		if (closeDialogOnBooking && dialogId) {
			const dispatchBookingFlow = (phase) => {
				window.dispatchEvent(new CustomEvent('dialog-booking:flow', { detail: { dialogId, phase } }));
			};
			const onPending = () => dispatchBookingFlow('pending');
			const onSuccess = () => dispatchBookingFlow('success');
			Cal.ns[namespace]('on', { action: 'bookingSubmitted', callback: onPending });
			Cal.ns[namespace]('on', { action: 'bookingSuccessfulV2', callback: onSuccess });
			Cal.ns[namespace]('on', { action: 'bookingSuccessful', callback: onSuccess });
			Cal.ns[namespace]('on', { action: 'rescheduleBookingSuccessfulV2', callback: onSuccess });
		}
	};

	/* Never on page load: crawlers and lab audits must not fetch Cal.com. The dialog calendar still has to be ready by the time a visitor opens it. */
	const calDialog = calHost?.closest('dialog');
	if (calDialog instanceof HTMLDialogElement && !calDialog.open) {
		const anyInteraction = ['scroll', 'touchstart', 'pointerdown', 'keydown'];
		const triggerIntent = ['pointerover', 'focusin'];
		const mountOnce = () => {
			anyInteraction.forEach((type) => window.removeEventListener(type, mountOnce, true));
			triggerIntent.forEach((type) => document.removeEventListener(type, onTriggerIntent, true));
			mountCal();
		};
		const onTriggerIntent = (event) => {
			if (event.target instanceof Element && event.target.closest('[data-booking-open]')) mountOnce();
		};
		anyInteraction.forEach((type) => window.addEventListener(type, mountOnce, { capture: true, passive: true }));
		triggerIntent.forEach((type) => document.addEventListener(type, onTriggerIntent, { capture: true, passive: true }));
		calDialog.addEventListener('toggle', () => {
			if (!calDialog.open) return;
			requestAnimationFrame(() => {
				if (calDialog.open) mountOnce();
			});
		});
	} else if (calHost && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				mountCal();
			},
			{ rootMargin: '100% 0px' },
		);
		observer.observe(calHost);
	} else {
		mountCal();
	}
</script>
