---
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const field =
	'w-full rounded-lg border border-line bg-white px-3 py-3 text-base font-normal text-ink';
const label = 'grid gap-1 text-sm font-semibold';
const config = {
	apiUrl: import.meta.env.PUBLIC_CONTACT_FORM_URL || 'https://forge.1344.fr/api/v1/send_form',
	apiToken: import.meta.env.PUBLIC_CONTACT_FORM_TOKEN || '',
	subject: t('Contact.subject'),
	fields: {
		firstName: t('Contact.firstName'),
		lastName: t('Contact.lastName'),
		email: t('Contact.email'),
		phone: t('Contact.phone'),
		request: t('Contact.request'),
		message: t('Contact.message'),
	},
	status: {
		missingToken: t('Contact.missingToken'),
		sending: t('Contact.sending'),
		success: t('Contact.success'),
		error: t('Contact.error'),
	},
};
---

<dialog
	id="contact-dialog"
	class="m-auto w-[90%] max-w-2xl rounded-2xl border-0 p-0 shadow-2xl"
	aria-labelledby="contact-title"
>
	<div class="relative p-8">
		<button class="absolute top-3 right-4 cursor-pointer text-3xl text-muted" type="button" data-close aria-label={t('Contact.close')}>
			×
		</button>
		<h2 id="contact-title" class="text-center font-serif text-3xl leading-tight">{t('Contact.title')}</h2>
		<div id="contact-form-view">
			<p class="mt-3">{t('Contact.intro')}</p>
			<form id="contact-form" class="mt-6 grid gap-4">
				<div class="grid gap-4 sm:grid-cols-2">
					<label class={label}>{t('Contact.firstName')}<input class={field} name="firstName" autocomplete="given-name" required /></label>
					<label class={label}>{t('Contact.lastName')}<input class={field} name="lastName" autocomplete="family-name" required /></label>
				</div>
				<label class={label}>{t('Contact.email')}<input class={field} name="email" type="email" autocomplete="email" required /></label>
				<label class={label}>{t('Contact.phone')}<input class={field} name="phone" type="tel" autocomplete="tel" required /></label>
				<label class={label}>
					{t('Contact.request')}
					<select class={field} name="requestType">
						<option>{t('Contact.optionIndividual')}</option>
						<option>{t('Contact.optionCouple')}</option>
						<option>{t('Contact.optionOther')}</option>
					</select>
				</label>
				<label class={label}>{t('Contact.message')}<textarea class={field} name="message" rows="5" required /></label>
				<label class="flex items-start gap-3 text-sm font-normal">
					<input class="mt-1" name="consent" type="checkbox" required />
					{t('Contact.consent')}
				</label>
				<p id="form-status" class="min-h-6 text-center text-rose-laure" role="status" aria-live="polite"></p>
				<button
					class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white transition-colors duration-200 hover:border-rose-deep hover:bg-rose-deep disabled:cursor-not-allowed disabled:opacity-60"
					type="submit"
				>
					{t('Contact.submit')}
				</button>
			</form>
		</div>
		<div id="contact-sending-view" class="hidden py-12 text-center" role="status" aria-live="polite">
			<p class="text-lg text-ink">{t('Contact.sending')}</p>
			<div
				class="mx-auto mt-6 size-10 animate-spin rounded-full border-4 border-line border-t-rose-laure"
				aria-hidden="true"
			></div>
		</div>
		<div id="contact-success-view" class="hidden py-12 text-center" role="status" aria-live="polite">
			<p class="text-lg text-ink">{t('Contact.success')}</p>
			<button
				class="mt-8 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white transition-colors duration-200 hover:border-rose-deep hover:bg-rose-deep"
				type="button"
				data-close
			>
				{t('Contact.close')}
			</button>
		</div>
	</div>
</dialog>
<script id="forge-form-config" type="application/json" set:html={JSON.stringify(config)}></script>
<script>
	import { closeDialogAnimated } from '../lib/dialog';

	const dialog = document.querySelector('#contact-dialog');
	const form = document.querySelector('#contact-form');
	const status = document.querySelector('#form-status');
	const formView = document.querySelector('#contact-form-view');
	const sendingView = document.querySelector('#contact-sending-view');
	const successView = document.querySelector('#contact-success-view');

	function showFormView() {
		formView?.classList.remove('hidden');
		sendingView?.classList.add('hidden');
		successView?.classList.add('hidden');
	}

	function showSendingView() {
		formView?.classList.add('hidden');
		sendingView?.classList.remove('hidden');
		successView?.classList.add('hidden');
	}

	function showSuccessView() {
		formView?.classList.add('hidden');
		sendingView?.classList.add('hidden');
		successView?.classList.remove('hidden');
	}

	function resetContactDialog() {
		if (form instanceof HTMLFormElement) form.reset();
		if (status) status.textContent = '';
		showFormView();
	}

	function openContactDialog() {
		if (!(dialog instanceof HTMLDialogElement)) return;
		resetContactDialog();
		dialog.showModal();
	}

	document.querySelectorAll('[data-contact-open]').forEach((button) => {
		button.addEventListener('click', () => openContactDialog());
	});
	function closeContactDialog() {
		if (dialog instanceof HTMLDialogElement) closeDialogAnimated(dialog);
	}

	document.querySelectorAll('[data-close]').forEach((button) => {
		button.addEventListener('click', () => closeContactDialog());
	});
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) closeContactDialog();
	});
	dialog?.addEventListener('close', () => resetContactDialog());

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement) || !status) return;
		const configNode = document.querySelector('#forge-form-config');
		const config = JSON.parse(configNode?.textContent || '{}');
		const data = Object.fromEntries(new FormData(form));
		const button = form.querySelector('button[type="submit"]');
		if (!(button instanceof HTMLButtonElement)) return;
		if (!config.apiToken) {
			status.textContent = config.status.missingToken;
			return;
		}
		button.disabled = true;
		status.textContent = '';
		showSendingView();
		try {
			const response = await fetch(config.apiUrl, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					Authorization: `Bearer ${config.apiToken}`,
				},
				body: JSON.stringify({
					from_email: data.email,
					from_name: `${data.firstName} ${data.lastName}`,
					subject: config.subject,
					fields: {
						[config.fields.firstName]: data.firstName,
						[config.fields.lastName]: data.lastName,
						[config.fields.email]: data.email,
						[config.fields.phone]: data.phone,
						[config.fields.request]: data.requestType,
						[config.fields.message]: data.message,
					},
				}),
			});
			if (!response.ok) throw new Error();
			form.reset();
			showSuccessView();
		} catch {
			showFormView();
			status.textContent = config.status.error;
		} finally {
			button.disabled = false;
		}
	});
</script>