---
import BookingDetails from './BookingDetails.astro';
import { getFixedT, type Locale } from '../i18n/i18n';
import { bookingHref } from '../lib/paths';

interface Props {
	locale: Locale;
	showEyebrow?: boolean;
}

const { locale, showEyebrow = false } = Astro.props;
const t = getFixedT(locale);
---

<section class="bg-rose-laure px-6 py-14 text-center text-white md:px-16">
	{showEyebrow && (
		<p class="mb-4 text-xs tracking-widest text-sand uppercase">{t('BookingCta.eyebrow')}</p>
	)}
	<h2 class="font-serif text-3xl leading-tight md:text-4xl">{t('BookingCta.title')}</h2>
	<BookingDetails locale={locale} variant="onRose" />
	<a
		class="mt-6 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-white bg-white px-6 py-3 text-sm text-rose-deep transition-colors duration-200 hover:bg-sand"
		href={bookingHref(locale)}
		data-booking-open
	>
		{t('Nav.bookingCta')}
	</a>
</section>
