---
import { getFixedT, type Locale } from '../i18n/i18n';

interface Props {
	locale: Locale;
	variant?: 'default' | 'onRose';
}
const { locale, variant = 'default' } = Astro.props;
const t = getFixedT(locale);
const paragraphs = t('BookingCta.paragraphs', { returnObjects: true }) as string[];
const wrap = variant === 'onRose' ? 'mx-auto max-w-prose text-start text-sand' : 'mx-auto max-w-prose text-start';
---

<div class={wrap}>
	{paragraphs.map((paragraph) => <p class="my-4">{paragraph}</p>)}
</div>
