---
import { Image } from 'astro:assets';
import brandIcon from '../assets/images/brand/laure_corrao_icon.png';

interface Props {
	alt: string;
	/** Displayed size, rendered at twice its CSS size for dense screens */
	variant?: 'header' | 'footer' | 'sidebar';
	class?: string;
}

const { alt, variant = 'header', class: className } = Astro.props;

const variants = {
	header: { size: 112, class: 'h-12 w-12 sm:h-14 sm:w-14' },
	footer: { size: 160, class: 'h-16 w-16 sm:h-20 sm:w-20' },
	sidebar: { size: 80, class: 'h-10 w-10' },
} as const;

const v = variants[variant];
---

<Image
	class:list={['object-contain', v.class, className]}
	src={brandIcon}
	width={v.size}
	height={v.size}
	alt={alt}
	loading={variant === 'header' ? 'eager' : 'lazy'}
	fetchpriority={variant === 'header' ? 'low' : undefined}
/>
