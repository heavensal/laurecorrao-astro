---
import { Image } from 'astro:assets';
import ExternalLinkIcon from '../assets/svg/externalLink.astro';
import SupportJourney from './SupportJourney.astro';
import HomeResources from './HomeResources.astro';
import ServiceIcon from './ServiceIcon.astro';
import portrait from '../assets/images/home/reference-laure.jpeg';
import practiceOffice from '../assets/images/home/practice-office.jpg';
import videoSession from '../assets/images/home/video-session.jpg';
import individualThumb from '../assets/images/individual/individual_meet.jpg';
import coupleThumb from '../assets/images/couples/couple-therapy-session.webp';
import { getFixedT, type Locale } from '../i18n/i18n';
import { homePortraitSizes, homePortraitWidths } from '../lib/images';
import { bookingHref, contentPath, pageHref } from '../lib/paths';
import { siteConfig } from '../site.config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const approachHref = pageHref(`${contentPath(locale, 'approach')}/`);
const individualHref = pageHref(`${contentPath(locale, 'individual')}/`);
const coupleHref = pageHref(`${contentPath(locale, 'couple')}/`);
const buttonBase =
	'inline-flex min-h-12 w-full items-center justify-center rounded-md border px-6 py-3 text-center text-sm no-underline transition-colors duration-200 sm:w-auto';
const button = `${buttonBase} border-rose-soft bg-rose-soft text-white hover:border-rose-deep hover:bg-rose-deep`;
const outline = `${buttonBase} border-blush bg-transparent text-ink hover:bg-sand`;
const textLink = 'inline-block text-rose-laure underline underline-offset-4';
const serviceLink =
	'border-t border-line px-6 py-6 text-center no-underline first:border-t-0 md:border-t-0 md:border-l md:first:border-l-0';
const topicCard =
	'flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-sm transition-shadow duration-200 hover:shadow-md';
const topicImageSizes = '(min-width: 768px) 50vw, 100vw';
const mapTitle = `${t('HomePage.practiceTitle')} — ${t('HomePage.practiceAddress')}`;
---

<section class="grid min-w-0 items-stretch bg-paper lg:grid-cols-2" aria-label={t('HomePage.eyebrow')}>
	<div class="min-w-0 px-6 py-16 md:px-10 lg:px-16 lg:py-20">
		<p class="mb-4 text-xs tracking-widest text-rose-laure uppercase">{t('HomePage.eyebrow')}</p>
		<h1 class="font-serif text-3xl leading-tight tracking-tight text-ink sm:text-4xl md:text-5xl lg:text-6xl" set:html={t('HomePage.titleHtml')} />
		<p class="mt-5 max-w-full font-serif text-xl leading-snug text-rose-laure sm:text-2xl">{t('HomePage.subtitle')}</p>
		<p class="mt-6 max-w-xl leading-relaxed">{t('HomePage.intro')}</p>
		<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
			<a class={button} href={bookingHref(locale)} data-booking-open>{t('Nav.bookingCta')}</a>
			<a class={outline} href={approachHref}>{t('HomePage.approachCta')}</a>
		</div>
	</div>
	<div class="relative min-h-80 min-w-0 overflow-hidden rounded-tl-4xl rounded-bl-4xl bg-sand lg:min-h-full">
		<Image
			class="absolute inset-0 h-full w-full object-cover object-center"
			src={portrait}
			widths={homePortraitWidths}
			sizes={homePortraitSizes}
			alt={t('HomePage.portraitAlt')}
			priority
		/>
	</div>
</section>
<section
	class="relative z-10 -mt-16 grid min-w-0 grid-cols-1 rounded-2xl border border-line bg-cream px-4 py-2 sm:mx-6 md:grid-cols-3"
	aria-label={t('HomePage.servicesAria')}
>
	<a class={serviceLink} href={individualHref}>
		<ServiceIcon kind="individual" />
		<h2 class="mt-3 font-serif text-xl text-ink">{t('Individual.h1')}</h2>
		<p class="mt-2 text-sm leading-relaxed text-muted" set:html={t('HomePage.individualSummaryHtml')} />
	</a>
	<a class={serviceLink} href={coupleHref}>
		<ServiceIcon kind="couple" />
		<h2 class="mt-3 font-serif text-xl text-ink">{t('Couple.h1')}</h2>
		<p class="mt-2 text-sm leading-relaxed text-muted" set:html={t('HomePage.coupleSummaryHtml')} />
	</a>
	<a class={serviceLink} href={approachHref}>
		<ServiceIcon kind="approach" />
		<h2 class="mt-3 font-serif text-xl text-ink">{t('HomePage.approachTitle')}</h2>
		<p class="mt-2 text-sm leading-relaxed text-muted" set:html={t('HomePage.approachSummaryHtml')} />
	</a>
</section>
<section class="grid items-start gap-10 px-6 py-16 md:px-10 lg:grid-cols-3 lg:px-16">
	<div>
		<p class="mb-4 text-xs tracking-widest text-rose-laure uppercase">{t('HomePage.aboutEyebrow')}</p>
		<h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">{t('HomePage.aboutTitle')}</h2>
		<span class="mt-6 block w-12 border-t-2 border-blush" aria-hidden="true"></span>
	</div>
	<div>
		<p>{t('HomePage.aboutBody')}</p>
		<a class="mt-4 inline-block text-rose-laure underline underline-offset-4" href={approachHref}>{t('HomePage.approachCta')}</a>
	</div>
	<blockquote class="relative rounded-2xl bg-sand px-8 py-8 font-serif text-muted">
		<span class="absolute top-3 left-4 font-serif text-5xl text-blush" aria-hidden="true">“</span>
		<p class="pl-6">{t('HomePage.quote')}</p>
	</blockquote>
</section>
<section class="bg-sand px-6 py-16 md:px-10 lg:px-16">
	<div class="grid items-center gap-8 lg:grid-cols-2">
		<div class="max-w-3xl">
			<h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">{t('HomePage.readingTitle')}</h2>
			<p class="mt-6">{t('HomePage.readingLead')}</p>
			<p class="mt-6">{t('HomePage.readingBody')}</p>
		</div>
		<SupportJourney locale={locale} />
	</div>
	<div class="mt-10 grid gap-8 md:grid-cols-2">
		<article class={topicCard}>
			<Image
				class="h-44 w-full object-cover"
				src={individualThumb}
				widths={[480, 800]}
				sizes={topicImageSizes}
				alt=""
			/>
			<div class="flex flex-1 flex-col p-6">
				<h3 class="font-serif text-2xl text-ink">{t('Individual.h1')}</h3>
				<p class="mt-4 flex-1">{t('Individual.lede')}</p>
				<p class="mt-4 text-sm text-muted">{t('HomePage.individualMeta')}</p>
				<a class={`${textLink} mt-6`} href={individualHref}>{t('HomePage.individualCta')}</a>
			</div>
		</article>
		<article class={topicCard}>
			<Image
				class="h-44 w-full object-cover"
				src={coupleThumb}
				widths={[480, 800]}
				sizes={topicImageSizes}
				alt=""
			/>
			<div class="flex flex-1 flex-col p-6">
				<h3 class="font-serif text-2xl text-ink">{t('Couple.h1')}</h3>
				<p class="mt-4 flex-1">{t('Couple.lede')}</p>
				<p class="mt-4 text-sm text-muted">{t('HomePage.coupleMeta')}</p>
				<a class={`${textLink} mt-6`} href={coupleHref}>{t('HomePage.coupleCta')}</a>
			</div>
		</article>
	</div>
</section>
<section class="px-6 py-16 md:px-10 lg:px-16">
	<h2 class="font-serif text-3xl leading-tight text-ink md:text-4xl">{t('HomePage.placeTitle')}</h2>
	<p class="mt-6 max-w-3xl">{t('HomePage.placeBody')}</p>
	<div class="mt-10 grid gap-8 md:grid-cols-2">
		<article class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
			<div class="relative h-52 w-full md:h-64 lg:h-72" data-map>
				<Image
					class="absolute inset-0 h-full w-full object-cover"
					src={practiceOffice}
					widths={[480, 900]}
					sizes={topicImageSizes}
					alt={t('HomePage.practicePhotoAlt')}
				/>
				<button
					class="absolute right-4 bottom-4 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-line bg-white px-4 py-2 text-sm text-ink transition-colors duration-200 hover:border-blush hover:text-rose-laure"
					type="button"
					data-map-load
					hidden
				>
					{t('HomePage.mapShow')}
				</button>
				<template data-map-frame>
					<iframe
						class="absolute inset-0 h-full w-full border-0"
						src={siteConfig.mapsEmbedUrl}
						title={mapTitle}
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</template>
			</div>
			<div class="p-6">
				<h3 class="font-serif text-2xl text-ink">{t('HomePage.practiceTitle')}</h3>
				<p class="mt-4">{t('HomePage.practiceBody')}</p>
				<a
					class="mt-4 inline-block font-medium text-rose-laure underline underline-offset-4"
					href={siteConfig.mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{t('HomePage.practiceAddress')} — {t('HomePage.practiceMapsLabel')}
					<ExternalLinkIcon />
					<span class="sr-only">{t('HomePage.mapsOpensNewTab')}</span>
				</a>
			</div>
		</article>
		<article class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
			<Image
				class="h-52 w-full object-cover"
				src={videoSession}
				widths={[480, 900]}
				sizes={topicImageSizes}
				alt={t('HomePage.videoPhotoAlt')}
			/>
			<div class="p-6">
				<h3 class="font-serif text-2xl text-ink">{t('HomePage.videoTitle')}</h3>
				<p class="mt-4">{t('HomePage.videoBody')}</p>
			</div>
		</article>
	</div>
	<p class="mt-8 max-w-3xl">{t('HomePage.placeClose')}</p>
	<div class="mt-8 flex justify-center">
		<a class={button} href={bookingHref(locale)} data-booking-open>{t('Nav.bookingCta')}</a>
	</div>
</section>
<HomeResources locale={locale} />

<script>
	document.querySelectorAll<HTMLElement>('[data-map]').forEach((container) => {
		const button = container.querySelector('[data-map-load]');
		const template = container.querySelector('template[data-map-frame]');
		if (!(button instanceof HTMLButtonElement) || !(template instanceof HTMLTemplateElement)) return;
		button.hidden = false;
		button.addEventListener('click', () => {
			const frame = template.content.firstElementChild?.cloneNode(true);
			if (!(frame instanceof HTMLIFrameElement)) return;
			container.append(frame);
			button.remove();
			frame.focus();
		});
	});
</script>
