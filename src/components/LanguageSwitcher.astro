---
import { getFixedT, isMultilangEnabled, type Locale } from '../i18n/i18n';
import { pageHref, pageRoutes } from '../lib/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const multilangEnabled = isMultilangEnabled();
---

{
	multilangEnabled && (
		<nav class="lang-switch" aria-label={t('LanguageSwitcher.ariaLabel')}>
			{locale === 'fr' ? (
				<span aria-current="true" lang="fr">
					{t('LanguageSwitcher.labelFr')}
				</span>
			) : (
				<a href={pageHref(pageRoutes.home)} hreflang="fr" lang="fr" title={t('LanguageSwitcher.titleFr')}>
					{t('LanguageSwitcher.labelFr')}
				</a>
			)}
			<span aria-hidden="true">|</span>
			{locale === 'en' ? (
				<span aria-current="true" lang="en">
					{t('LanguageSwitcher.labelEn')}
				</span>
			) : (
				<a href={pageHref(pageRoutes.englishHome)} hreflang="en" lang="en" title={t('LanguageSwitcher.titleEn')}>
					{t('LanguageSwitcher.labelEn')}
				</a>
			)}
		</nav>
	)
}
