---
import type { Locale } from '../../i18n/i18n';
import { formatCmsDate, type CmsArticleSummary } from '../../lib/forge-blog';
import { localePathPrefix, pageHref } from '../../lib/paths';

interface Props {
	locale: Locale;
	post: CmsArticleSummary;
	heading?: 'h2' | 'h3';
}

const { locale, post, heading = 'h2' } = Astro.props;
const Heading = heading;
const date = formatCmsDate(post.publishedAt, locale);
const href = pageHref(`${localePathPrefix(locale)}blog/${post.slug}/`);
---

<article class="group relative overflow-hidden rounded-lg bg-gray-900 shadow-sm transition-shadow duration-200 hover:shadow-lg motion-reduce:transition-none">
	{
		post.coverImageUrl && (
			<img
				class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
				src={post.coverImageUrl}
				alt=""
			/>
		)
	}
	<div class="relative bg-linear-to-t from-gray-900/90 via-gray-900/60 to-gray-900/20 pt-32 sm:pt-48 lg:pt-64">
		<div class="p-4 sm:p-6">
			{
				date && (
					<time class="block text-xs text-white/90" datetime={post.publishedAt ?? undefined}>
						{date}
					</time>
				)
			}
			<Heading class="mt-1 text-lg leading-snug text-white">
				<a class="text-white no-underline after:absolute after:inset-0" href={href}>{post.title}</a>
			</Heading>
			{post.description && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-white/95">{post.description}</p>}
		</div>
	</div>
</article>
