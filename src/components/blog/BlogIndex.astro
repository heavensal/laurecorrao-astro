---
import { getFixedT, type Locale } from '../../i18n/i18n';
import { formatCmsDate, type CmsArticleSummary } from '../../lib/forge-blog';
import { homePathForLocale, localePathPrefix, pageHref } from '../../lib/paths';

interface Props {
	locale: Locale;
	posts: CmsArticleSummary[];
}

const { locale, posts } = Astro.props;
const t = getFixedT(locale);
const homeUrl = pageHref(homePathForLocale(locale) || '/');
const prefix = localePathPrefix(locale);
---

<section class="page-head">
	<p><a href={homeUrl}>{t('Blog.back')}</a></p>
	<p class="eyebrow">{t('Blog.eyebrow')}</p>
	<h1>{t('Blog.h1')}</h1>
	<p class="lede">{t('Blog.intro')}</p>
</section>
<section class="section article-grid">
	{
		posts.length === 0 ? (
			<p>{t('Blog.empty')}</p>
		) : (
			posts.map((post) => {
				const date = formatCmsDate(post.publishedAt, locale);
				const href = pageHref(`${prefix}blog/${post.slug}/`);
				return (
					<article class="article-card">
						{post.coverImageUrl && (
							<img class="article-cover" src={post.coverImageUrl} alt="" />
						)}
						<p class="eyebrow">{t('Blog.eyebrow')}</p>
						<h2>
							<a href={href}>{post.title}</a>
						</h2>
						{date && (
							<p>
								<time datetime={post.publishedAt ?? undefined}>{date}</time>
							</p>
						)}
						{post.description && <p>{post.description}</p>}
						<a href={href}>{t('Blog.read')}</a>
					</article>
				);
			})
		)
	}
</section>
