---
import BlogCard from './blog/BlogCard.astro';
import BookingCTA from './BookingCTA.astro';
import { getFixedT, type Locale } from '../i18n/i18n';
import { fetchFaqs, fetchReviews } from '../lib/forge-blocks';
import { fetchPublishedSummaries } from '../lib/forge-blog';
import { localFaqs, localReviews } from '../lib/local-blocks';
import { localePathPrefix, pageHref } from '../lib/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getFixedT(locale);
const prefix = localePathPrefix(locale);
const posts = (await fetchPublishedSummaries(locale)).slice(0, 3);
const fromReviews = await fetchReviews(locale);
const reviews = (
	fromReviews
		? fromReviews.map((review) => ({
				author: review.author,
				rating: review.rating,
				text: review.content,
			}))
		: localReviews(locale)
).slice(0, 3);
const faqs = (await fetchFaqs(locale)) ?? localFaqs(locale);
const blogHref = pageHref(`${prefix}blog/`);
const eyebrow = 'mb-4 text-xs tracking-widest text-rose-laure uppercase';
const heading = 'font-serif text-3xl leading-tight text-ink md:text-4xl';
---

<section class="bg-sand px-6 py-16 md:px-10 lg:px-16" aria-labelledby="reviews-title">
	<p class={eyebrow}>{t('Resources.reviewsEyebrow')}</p>
	<h2 id="reviews-title" class={heading}>{t('Resources.reviewsTitle')}</h2>
	<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{
			reviews.map((review) => (
				<blockquote class="rounded-2xl border border-line bg-white p-7">
					<span class="tracking-widest text-rose-laure" aria-label={t('Resources.stars', { rating: review.rating })}>
						{'★'.repeat(review.rating)}
					</span>
					<p class="mt-3 font-serif text-lg leading-relaxed">“{review.text}”</p>
					<cite class="mt-4 block text-sm text-muted not-italic">{review.author}</cite>
				</blockquote>
			))
		}
	</div>
</section>
<section class="px-6 py-16 md:px-10 lg:px-16" aria-labelledby="articles-title">
	<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
		<div>
			<p class={eyebrow}>{t('Blog.eyebrow')}</p>
			<h2 id="articles-title" class={heading}>{t('Blog.homeTitle')}</h2>
		</div>
		{posts.length > 0 && <a class="text-rose-laure underline underline-offset-4" href={blogHref}>{t('Blog.all')}</a>}
	</div>
	{
		posts.length === 0 ? (
			<p class="mt-8">{t('Blog.empty')}</p>
		) : (
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((article) => (
					<BlogCard locale={locale} post={article} heading="h3" />
				))}
			</div>
		)
	}
</section>
<section class="bg-paper px-6 py-16 md:px-10 lg:px-16" aria-labelledby="faq-title">
	<p class={eyebrow}>{t('Resources.faqEyebrow')}</p>
	<h2 id="faq-title" class={heading}>{t('Resources.faqTitle')}</h2>
	<div class="mt-6 max-w-4xl">
		{
			faqs.map((faq) => (
				<details class="group border-t border-line last:border-b">
					<summary class="flex cursor-pointer items-center justify-between gap-5 py-5 font-serif text-lg">
						{faq.question}
						<span class="text-2xl text-rose-laure transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">
							+
						</span>
					</summary>
					<p class="max-w-3xl pb-4 text-muted">{faq.answer}</p>
				</details>
			))
		}
	</div>
	<button class="mt-6 cursor-pointer text-rose-laure underline underline-offset-4" type="button" data-contact-open>
		{t('Resources.otherQuestion')}
	</button>
</section>
<section class="flex flex-col items-start justify-between gap-6 bg-rose-laure px-6 py-12 text-white md:flex-row md:items-center md:px-16">
	<div>
		<p class="mb-4 text-xs tracking-widest text-sand uppercase">{t('Resources.contactEyebrow')}</p>
		<h2 class="font-serif text-3xl leading-tight">{t('Resources.contactTitle')}</h2>
	</div>
	<button
		class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md border border-white bg-white px-6 py-3 text-sm text-rose-deep transition-colors duration-200 hover:bg-sand"
		type="button"
		data-contact-open
	>
		{t('Resources.contactCta')}
	</button>
</section>
<BookingCTA locale={locale} />
