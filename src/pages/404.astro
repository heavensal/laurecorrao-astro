---
import { getFixedT, isMultilangEnabled } from '../i18n/i18n';
import Layout from '../layouts/Layout.astro';
import { pageHref } from '../lib/paths';

const fr = getFixedT('fr');
const en = getFixedT('en');
const showEnglish = isMultilangEnabled();
const homeFr = pageHref('');
const homeEn = pageHref('en/');
---

<Layout title={fr('NotFound.metaTitle')} description={fr('NotFound.metaDescription')} robots="noindex, nofollow">
	<section class="px-6 py-16" data-not-found="fr">
		<h1 class="font-serif text-4xl leading-tight">{fr('NotFound.title')}</h1>
		<a
			class="mt-6 inline-flex min-h-12 items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white no-underline"
			href={homeFr}
		>
			{fr('NotFound.home')}
		</a>
	</section>
	{
		showEnglish && (
			<section class="px-6 py-16" data-not-found="en" hidden>
				<h1 class="font-serif text-4xl leading-tight">{en('NotFound.title')}</h1>
				<a
					class="mt-6 inline-flex min-h-12 items-center justify-center rounded-md border border-rose-soft bg-rose-soft px-6 py-3 text-sm text-white no-underline"
					href={homeEn}
				>
					{en('NotFound.home')}
				</a>
			</section>
		)
	}
	{
		showEnglish && (
			<script define:vars={{ enTitle: en('NotFound.metaTitle'), enPrefix: homeEn }}>
				const path = window.location.pathname.replace(/\/$/, '') || '/';
				const prefix = enPrefix.replace(/\/$/, '');
				const english = path === prefix || path.startsWith(`${prefix}/`);
				if (english) {
					document.documentElement.lang = 'en';
					document.title = enTitle;
					const french = document.querySelector('[data-not-found="fr"]');
					const englishPanel = document.querySelector('[data-not-found="en"]');
					if (french instanceof HTMLElement) french.hidden = true;
					if (englishPanel instanceof HTMLElement) englishPanel.hidden = false;
				}
			</script>
		)
	}
</Layout>
