---
import HomePage from '../components/HomePage.astro';
import LcpPreload from '../components/LcpPreload.astro';
import { getFixedT } from '../i18n/i18n';
import Layout from '../layouts/Layout.astro';
import { alternateUrls, homeJsonLd } from '../lib/pages';
import { buildAlternateLanguages } from '../lib/seo';

const t = getFixedT('fr');
const { fr, en } = alternateUrls(Astro.site, 'home');
---

<Layout
	title={t('Home.metaTitle')}
	description={t('Home.metaDescription')}
	alternateLanguages={buildAlternateLanguages({ fr, en })}
	jsonLd={await homeJsonLd(Astro.site, 'fr')}
>
	<LcpPreload slot="head" />
	<HomePage locale="fr" />
</Layout>
