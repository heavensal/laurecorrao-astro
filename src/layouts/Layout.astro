---
/**
 * Layout — SEO (title, description, canonical, Open Graph, Twitter),
 * hreflang, JSON-LD, favicon, skip link, accessibility.
 */
import '../styles/global.css';
import ContactForm from '../components/ContactForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getFixedT, type Locale } from '../i18n/i18n';
import { pageHref } from '../lib/paths';
import { absolutePageUrl, buildAlternateLanguages, publishedOgLocaleAlternate } from '../lib/seo';
import { siteConfig } from '../site.config';

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
	robots?: string;
	image?: string;
	ogImageAlt?: string;
	alternateLanguages?: { hreflang: string; href: string }[];
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	lang = 'fr',
	robots = 'index, follow',
	image,
	ogImageAlt,
	alternateLanguages,
	jsonLd,
} = Astro.props;

const t = getFixedT(lang);
const pageTitle = `${title ?? t('Home.metaTitle')} | ${siteConfig.name}`;
const pageDescription = description ?? t('Home.metaDescription');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const selfUrl = absolutePageUrl(Astro.site, Astro.url.pathname);
const alternates = alternateLanguages ?? buildAlternateLanguages({ [lang]: selfUrl ?? canonical });
const ogLocale = lang === 'en' ? 'en_US' : 'fr_FR';
const ogAlternate = publishedOgLocaleAlternate(lang);
const usesDefaultImage = !image;
const imageAlt = ogImageAlt ?? (usesDefaultImage ? t('HomePage.portraitAlt') : undefined);

function absolutePublic(path: string): string | undefined {
	if (!Astro.site) return undefined;
	const clean = path.startsWith('/') ? path.slice(1) : path;
	return new URL(import.meta.env.BASE_URL + clean, Astro.site).href;
}

const ogImage = image
	? image.startsWith('http')
		? image
		: absolutePublic(image)
	: absolutePublic(siteConfig.ogImageUrl);
const jsonLdString = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content={siteConfig.themeColor} />
		<meta name="author" content={siteConfig.name} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{canonical && <link rel="canonical" href={canonical} />}
		{
			alternates?.map(({ hreflang, href }) => (
				<link rel="alternate" hreflang={hreflang} href={href} />
			))
		}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		{ogAlternate && <meta property="og:locale:alternate" content={ogAlternate} />}
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && usesDefaultImage && <meta property="og:image:width" content={String(siteConfig.ogImageWidth)} />}
		{ogImage && usesDefaultImage && <meta property="og:image:height" content={String(siteConfig.ogImageHeight)} />}
		{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		{
			siteConfig.twitterHandle && (
				<meta name="twitter:site" content={`@${siteConfig.twitterHandle.replace(/^@/, '')}`} />
			)
		}
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		{ogImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<link rel="icon" type="image/svg+xml" href={pageHref('favicon.svg')} />
		{jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}
	</head>
	<body class="min-h-screen overflow-x-clip bg-cream font-sans text-base leading-relaxed text-ink antialiased">
		<a class="absolute -top-24 left-4 z-50 bg-white px-4 py-2 text-ink focus:top-4" href="#content">
			{t('Layout.skipToContent')}
		</a>
		<SiteHeader locale={lang} />
		<main id="content" class="min-w-0"><slot /></main>
		<SiteFooter locale={lang} />
		<ContactForm locale={lang} />
	</body>
</html>
